{
  "tools": {
    "git_create_branch": {
      "description": "Create a new git branch",
      "parameters": {
        "name": {"type": "string", "required": true}
      },
      "security_level": "write",
      "implementation": "gitree"
    },
    "git_read_branch": {
      "description": "Read files from a branch",
      "parameters": {
        "branch": {"type": "string", "required": true}
      },
      "security_level": "read",
      "implementation": "gitree"
    },
    "git_commit": {
      "description": "Commit output to a branch",
      "parameters": {
        "branch": {"type": "string", "required": true},
        "output": {"type": "object", "required": true}
      },
      "security_level": "write",
      "implementation": "gitree"
    },
    "git_merge": {
      "description": "Merge source branch into target branch",
      "parameters": {
        "source": {"type": "string", "required": true},
        "target": {"type": "string", "required": true}
      },
      "security_level": "write",
      "implementation": "gitree"
    },
    "git_delete_branch": {
      "description": "Delete a git branch",
      "parameters": {
        "name": {"type": "string", "required": true}
      },
      "security_level": "write",
      "implementation": "gitree"
    },
    "git_clear_branch": {
      "description": "Clear all files from a branch for retry",
      "parameters": {
        "name": {"type": "string", "required": true}
      },
      "security_level": "write",
      "implementation": "gitree"
    },
    "db_query": {
      "description": "Query database table",
      "parameters": {
        "table": {"type": "string", "required": true},
        "columns": {"type": "array", "required": false},
        "where": {"type": "object", "required": false},
        "limit": {"type": "integer", "required": false}
      },
      "security_level": "read",
      "implementation": "db"
    },
    "db_update": {
      "description": "Update database record",
      "parameters": {
        "table": {"type": "string", "required": true},
        "id": {"type": "string", "required": true},
        "data": {"type": "object", "required": true}
      },
      "security_level": "write",
      "implementation": "db"
    },
    "db_insert": {
      "description": "Insert new record into database table",
      "parameters": {
        "table": {"type": "string", "required": true},
        "data": {"type": "object", "required": true}
      },
      "security_level": "write",
      "implementation": "db"
    },
    "db_rpc": {
      "description": "Call database RPC function",
      "parameters": {
        "name": {"type": "string", "required": true},
        "params": {"type": "object", "required": false}
      },
      "security_level": "write",
      "implementation": "db"
    },
    "command_maintenance": {
      "description": "Queue a maintenance command",
      "parameters": {
        "command": {"type": "string", "required": true},
        "params": {"type": "object", "required": false}
      },
      "security_level": "write",
      "implementation": "db"
    },
    "file_read": {
      "description": "Read file from repository",
      "parameters": {
        "path": {"type": "string", "required": true}
      },
      "security_level": "read",
      "implementation": "file"
    },
    "file_write": {
      "description": "Write file to repository",
      "parameters": {
        "path": {"type": "string", "required": true},
        "content": {"type": "string", "required": true}
      },
      "security_level": "write",
      "implementation": "file"
    },
    "file_delete": {
      "description": "Delete file from repository",
      "parameters": {
        "path": {"type": "string", "required": true}
      },
      "security_level": "write",
      "implementation": "file"
    },
    "vault_get": {
      "description": "Get secret from vault (returns existence only, not value)",
      "parameters": {
        "key": {"type": "string", "required": true}
      },
      "security_level": "secret",
      "implementation": "vault"
    },
    "web_search": {
      "description": "Search the web using DuckDuckGo",
      "parameters": {
        "query": {"type": "string", "required": true}
      },
      "security_level": "read",
      "implementation": "web"
    },
    "web_fetch": {
      "description": "Fetch content from a URL",
      "parameters": {
        "url": {"type": "string", "required": true}
      },
      "security_level": "read",
      "implementation": "web"
    },
    "sandbox_test": {
      "description": "Run code in sandbox for testing",
      "parameters": {
        "files": {"type": "array", "required": true},
        "test_command": {"type": "string", "required": false}
      },
      "security_level": "execute",
      "implementation": "sandbox"
    },
    "run_lint": {
      "description": "Run linter on codebase",
      "parameters": {
        "path": {"type": "string", "required": false}
      },
      "security_level": "execute",
      "implementation": "sandbox"
    },
    "run_typecheck": {
      "description": "Run type checker on codebase",
      "parameters": {
        "path": {"type": "string", "required": false}
      },
      "security_level": "execute",
      "implementation": "sandbox"
    },
    "kb_search_symbols": {
      "description": "Search knowledge base for code symbols (functions, types, methods)",
      "parameters": {
        "query": {"type": "string", "required": true},
        "filter_repo": {"type": "string", "required": false},
        "limit": {"type": "integer", "required": false}
      },
      "security_level": "read",
      "implementation": "kb"
    },
    "kb_search_docs": {
      "description": "Search knowledge base for documentation sections",
      "parameters": {
        "query": {"type": "string", "required": true},
        "filter_repo": {"type": "string", "required": false},
        "limit": {"type": "integer", "required": false}
      },
      "security_level": "read",
      "implementation": "kb"
    },
    "kb_get_callers": {
      "description": "Find all code locations that call a specific function",
      "parameters": {
        "qualified_name": {"type": "string", "required": true}
      },
      "security_level": "read",
      "implementation": "kb"
    },
    "kb_get_callees": {
      "description": "Find all functions called by a specific function",
      "parameters": {
        "qualified_name": {"type": "string", "required": true}
      },
      "security_level": "read",
      "implementation": "kb"
    },
    "kb_get_blast_radius": {
      "description": "Trace impact radius of changing a function (callers of callers)",
      "parameters": {
        "qualified_name": {"type": "string", "required": true},
        "max_depth": {"type": "integer", "required": false}
      },
      "security_level": "read",
      "implementation": "kb"
    },
    "kb_context_pack": {
      "description": "Get a topic-oriented context pack from the knowledge base",
      "parameters": {
        "query": {"type": "string", "required": true},
        "repo_id": {"type": "string", "required": false}
      },
      "security_level": "read",
      "implementation": "kb"
    },
    "kb_list_decisions": {
      "description": "List all architecture decision records",
      "parameters": {},
      "security_level": "read",
      "implementation": "kb"
    },
    "kb_get_stale_docs": {
      "description": "Find documentation that may be out of sync with code",
      "parameters": {
        "repo_id": {"type": "string", "required": false},
        "limit": {"type": "integer", "required": false}
      },
      "security_level": "read",
      "implementation": "kb"
    }
  }
}
