{
  "enabled": true,
  "capture_pages": [
    {
      "url": "https://vibeflow-dashboard.vercel.app",
      "name": "dashboard-main",
      "viewports": [
        1280,
        768,
        375
      ]
    },
    {
      "url": "https://vibeflow-dashboard.vercel.app/tasks",
      "name": "tasks-page",
      "viewports": [
        1280,
        768
      ]
    },
    {
      "url": "https://vibeflow-dashboard.vercel.app/roi",
      "name": "roi-page",
      "viewports": [
        1280
      ]
    }
